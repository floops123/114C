<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : aucune donnée sauvegardée dans le cloud ni transférée vers
     un nouvel appareil (secrets chiffrés par une clé propre à l'appareil). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
